**/node_modules
**/.next
**/dist
**/test-results
**/playwright-report
**/coverage
**/blob-report
**/*.tsbuildinfo
# next build copies apps/web/.env and .env.production into the standalone
# server, so a local env file must never reach the build context.
**/.env
**/.env.*
.git
docs
infra
.github
# The production-copy reader never writes into the repository; the same
# guard as .gitignore, so a dump saved here by hand never reaches a build.
**/*.sql
**/*.sql.gz
**/sportbet-migrate-*
!packages/db/migrations/*.sql
