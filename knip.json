{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["quality/**/*.mjs"]
    },
    "packages/domain": {},
    "packages/db": {
      "entry": ["src/{index,migrations}.ts", "src/bin/*.ts"]
    },
    "tools/migrate": {
      "entry": ["src/bin/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,route,not-found,error,loading}.tsx",
        "src/app/**/route.ts",
        "src/{proxy,instrumentation}.ts",
        "playwright.config.ts"
      ],
      "playwright": {
        "config": [],
        "entry": ["e2e/**/*.spec.ts"]
      },
      "vitest": {
        "config": ["vitest.*.config.ts"]
      }
    }
  }
}
