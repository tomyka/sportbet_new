{
  "name": "sportbet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test:unit": "pnpm --filter @sportbet/domain test",
    "test:db": "pnpm --filter @sportbet/db test",
    "test:component": "pnpm --filter @sportbet/web test:component",
    "test:feature": "pnpm --filter @sportbet/web test:feature",
    "test:e2e": "pnpm --filter @sportbet/web test:e2e",
    "test:smoke": "pnpm --filter @sportbet/web test:smoke",
    "check": "node quality/gate.mjs check",
    "check:all": "node quality/gate.mjs all",
    "mutation": "node quality/gate.mjs mutation",
    "mutation:full": "node quality/gate.mjs mutation --full",
    "fix": "node quality/fix.mjs",
    "crap": "node quality/crap.mjs --top 20"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "knip": "6.42.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  }
}
