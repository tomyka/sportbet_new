{
  "$comment": "Single source of truth for quality thresholds. Protected from agent edits by quality/hooks/protect-config.mjs. Change only by hand.",
  "sourceGlobs": [
    "apps/*/src/**/*.{ts,tsx,mts,cts}",
    "packages/*/src/**/*.{ts,tsx,mts,cts}",
    "tools/*/src/**/*.{ts,tsx,mts,cts}"
  ],
  "testGlobs": ["**/*.{test,spec}.{ts,tsx,mts,cts}"],
  "coverage": {
    "lines": 80,
    "branches": 75,
    "functions": 80,
    "statements": 80
  },
  "crap": {
    "max": 30,
    "baselineFile": "quality/crap-baseline.json"
  },
  "mutation": {
    "breakChanged": 60,
    "breakFull": 50
  },
  "forbiddenMarkers": [
    "eslint-disable",
    "@ts-nocheck",
    "@ts-ignore",
    "istanbul ignore",
    "v8 ignore",
    "c8 ignore",
    "Stryker disable"
  ],
  "stopHook": {
    "mutation": "changed",
    "maxConsecutiveBlocks": 5
  },
  "baseBranch": "main"
}
